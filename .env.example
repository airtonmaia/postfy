# =====================================================================
# Orquesia — variáveis de ambiente
#
# O que começa com VITE_ vai para o bundle e é PÚBLICO. O resto fica só
# nas funções serverless (/api), onde o navegador não alcança.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase — banco e autenticação (obrigatório)
# ---------------------------------------------------------------------
# Estes dois já têm um padrão embutido no código apontando para o projeto
# Postfy, então a aplicação sobe sem configuração. Preencha para apontar
# para outro projeto.
#
# A chave publicável é pública por definição: ela vai para o navegador de
# qualquer visitante. Quem protege os dados é a RLS, não o sigilo da chave.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# NUNCA coloque a service_role aqui nem em nenhuma variável VITE_:
# ela ignora a RLS e derrubaria o isolamento entre agências.

# ---------------------------------------------------------------------
# IA (opcional, só no servidor)
# ---------------------------------------------------------------------
# Sem chave, as rotas de IA respondem 503 e a interface avisa. Os dois pontos
# que usam IA (gerar copy e converter feedback em checklist) simplesmente
# ficam indisponíveis; o resto do sistema funciona igual.
#
# Qualquer fornecedor que fale o dialeto de chat completions da OpenAI serve.
# Presets prontos em IA_PROVEDOR: openrouter | gemini | groq | cerebras |
# mistral | openai
#
# O padrão é o OpenRouter: uma chave só dá acesso a dezenas de modelos, e os
# terminados em `:free` não cobram. Se um modelo gratuito sair do ar ou ficar
# lento, troque IA_MODELO — nada no código depende do fornecedor.
IA_PROVEDOR="openrouter"
IA_API_KEY=""
# Opcional: sobrepõe o modelo padrão do preset.
# Padrão do OpenRouter: meta-llama/llama-3.3-70b-instruct:free
IA_MODELO=""

# Para um endpoint fora dos presets (modelo local via Ollama/LM Studio,
# gateway próprio), informe a base e ignore IA_PROVEDOR:
# IA_BASE_URL="http://localhost:11434/v1"
# Alguns modelos locais quebram se receberem response_format:
# IA_SEM_JSON_NATIVO="true"

# ---------------------------------------------------------------------
# Arquivos — Cloudflare R2 (opcional, só no servidor)
# ---------------------------------------------------------------------
# Sem isto, o envio de arquivo avisa que não está configurado e a tela
# oferece anexar por URL.
#
# ACCOUNT_ID é o mesmo que aparece no endpoint S3 do bucket:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# ACCESS_KEY_ID e SECRET_ACCESS_KEY vêm de um token de API do R2 (painel da
# Cloudflare > R2 > Gerenciar tokens). O secret só é exibido uma vez.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="orquesia-midia"
# Domínio público do bucket: é por aqui que o navegador LÊ o arquivo depois de
# enviado. Sem isto o envio conclui e a tela avisa que falta configurar, em vez
# de salvar uma URL que não abre. Duas formas de obter:
#   1. Domínio próprio: R2 > Settings > Custom Domains (ex.: midia.orquesia.com.br)
#   2. Subdomínio da Cloudflare: R2 > Settings > Public Development URL,
#      que gera algo como https://pub-<hash>.r2.dev
R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------
# E-mail — Resend (opcional, só no servidor)
# ---------------------------------------------------------------------
# Sem isto o convite ainda é criado; só não sai o e-mail, e o link fica
# na tela para compartilhar à mão.
RESEND_API_KEY=""
RESEND_FROM="Orquesia <convites@orquesia.com.br>"

# Base usada nos links dos e-mails automáticos. Sem isto o link aponta para
# app.orquesia.com.br, que é o padrão embutido.
APP_URL="https://app.orquesia.com.br"

# ---------------------------------------------------------------------
# Analytics — PostHog (opcional)
# ---------------------------------------------------------------------
# Sem a chave, o analytics é um no-op. Session replay e autocapture ficam
# desligados de propósito: esta aplicação exibe contratos, faturamento e um
# cofre de senhas de clientes.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
