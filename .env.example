# =====================================================================
# Orquesia — variáveis de ambiente
# Copie para .env e preencha. O .env não vai para o repositório.
# =====================================================================

# Porta HTTP. Plataformas como Cloud Run e Render injetam esta variável.
PORT=3000

# ---------------------------------------------------------------------
# Sessão (obrigatório em produção)
# ---------------------------------------------------------------------
# Chave usada para assinar o cookie de sessão. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem esta variável o servidor gera um segredo e guarda em disco, o que faz
# todo mundo ser deslogado a cada redeploy em ambientes efêmeros.
SESSION_SECRET=""

# ---------------------------------------------------------------------
# Onde ficam os dados
# ---------------------------------------------------------------------
# Diretório do store em arquivo (usuários, convites e dados da agência).
# Em produção aponte para um volume persistente.
DATA_DIR="./data"

# ---------------------------------------------------------------------
# Primeiro acesso (opcional)
# ---------------------------------------------------------------------
# Cria o usuário proprietário inicial no boot, se ele ainda não existir.
# Útil para um deploy novo ter como entrar. A senha precisa ter 8+ caracteres.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
ADMIN_AGENCY="Minha Agência"

# ---------------------------------------------------------------------
# IA (opcional)
# ---------------------------------------------------------------------
# Sem esta chave, os recursos de IA respondem 503 e a interface avisa.
GEMINI_API_KEY=""
# Modelo usado nas gerações. Confirme o identificador disponível na sua conta.
GEMINI_MODEL="gemini-3.8-flash"

# ---------------------------------------------------------------------
# Supabase (opcional — caminho de migração do banco)
# ---------------------------------------------------------------------
# Rode supabase/schema.sql antes de usar: ele cria as tabelas e as políticas
# de RLS por workspace.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
