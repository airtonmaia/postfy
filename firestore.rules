rules_version = '2';

// O aplicativo deixou de usar o Firestore como banco: a persistência passou a
// ser servida pela API autenticada em /api/data (ver server/routes/data.ts).
//
// Estas regras negam tudo por padrão. Antes elas eram `allow read, write: if true`,
// o que deixava clientes, contratos e o cofre de senhas legíveis e apagáveis por
// qualquer pessoa que tivesse a chave pública do projeto.
//
// Se um dia o Firestore voltar a ser usado, substitua o bloco abaixo por regras
// que exijam request.auth e confiram a associação do usuário ao workspace do
// documento — nunca volte a liberar com `if true`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
